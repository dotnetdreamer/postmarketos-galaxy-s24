# Local bring-up package for the Galaxy S24 (Exynos 2400), not for upstream.
pkgname=device-samsung-e1s
pkgdesc="Samsung Galaxy S24 (Exynos)"
pkgver=1
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-samsung-e1s
	postmarketos-base
	postmarketos-base-downstream
"
makedepends="devicepkg-dev"
source="deviceinfo"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
}
