#!/usr/bin/env python3
"""s24-dockd: the phone as a desktop while a monitor is on the USB-C port.

Galaxy S24, postmarketOS (Claude, 2026-11-17). Runs in the desktop session, started by
/etc/xdg/autostart/s24-dock.desktop. While a monitor is connected:

Windows you can move. Plasma Mobile shows every app full screen and without a title bar, on
every screen, unless its Docked mode is on (the quick setting; convergenceModeEnabled in
plasmamobilerc's [General]). So docked mode is on while a monitor is connected, and when the
monitor goes it goes back to what the phone had. The same rules as Open Android DeX's
postmarketOS helper:
- What the phone had is kept in ~/.cache/s24-dock/docked-before until it is put back, so a
  restart or a flat battery while docked still puts it back at the next login
- A phone that had docked mode on already is left alone
- Writing the setting is not enough: plasma-mobile-envmanager --apply-settings gives KWin
  docked mode's rules (windows can be dragged, open centred, have title bar buttons), as
  Plasma Mobile's own switch does

Sound on the monitor. The Exynos sound card has a PCM straight to the DisplayPort link
("DP0 Audio", hw:0,31; Samsung's dp_dma driver). It only opens once the display driver has
read the monitor's audio support from its EDID and turned the picture on. If the monitor's
EDID says it plays sound, a PulseAudio sink for that PCM is added (named after the monitor),
made the default and given the streams that are playing; the default from before is kept
in ~/.cache/s24-dock/sink-before and put back when the monitor goes (the sink is removed
and PulseAudio moves its streams on). Picking another output while docked is left alone.

Monitor changes come from the kernel's DRM hotplug events (netlink, no polling); whether a
monitor is there is read from /sys/class/drm/card*-DP-*/status (USB-C) and HDMI-*. One copy
per session: the newest takes the session bus name and an older one quits. It quits with
the session. Log: ~/.cache/s24-dock/s24-dockd.log
"""
import glob
import os
import socket
import subprocess
import sys
import time

from gi.repository import Gio, GLib

NAME = "org.postmarketos.s24.Dock"
STATE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "s24-dock")
BEFORE = os.path.join(STATE, "docked-before")
SINK_BEFORE = os.path.join(STATE, "sink-before")
LOG = os.path.join(STATE, "s24-dockd.log")
KEY = ["--file", "plasmamobilerc", "--group", "General", "--key", "convergenceModeEnabled"]

DISPLAY_SINK = "s24_display"
DISPLAY_PCM = "hw:0,31"  # "DP0 Audio"
# As the speaker's sink (/etc/pulse/default.pa.d/s24-sound.pa), with 20 ms periods
DISPLAY_SINK_ARGS = ["device=" + DISPLAY_PCM, "sink_name=" + DISPLAY_SINK, "mmap=false", "tsched=false",
                     "fragments=4", "fragment_size=3840", "rate=48000", "channels=2", "format=s16le"]


def log(msg):
    try:
        with open(LOG, "a") as f:
            f.write(time.strftime("%m-%d %H:%M:%S ") + msg + "\n")
    except OSError:
        pass


def write_file(path, text):
    os.makedirs(STATE, exist_ok=True)
    with open(path, "w") as f:
        f.write(text + "\n")


def read_file(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return None


# ── the monitor ──────────────────────────────────────────────────────────

def connectors():
    return glob.glob("/sys/class/drm/card*-DP-*") + glob.glob("/sys/class/drm/card*-HDMI-*")


def monitor_connected():
    for c in connectors():
        if read_file(c + "/status") == "connected":
            return True
    return False


def monitor_edid():
    for c in connectors():
        if read_file(c + "/status") == "connected":
            try:
                with open(c + "/edid", "rb") as f:
                    return f.read()
            except OSError:
                pass
    return b""


def monitor_name():
    e = monitor_edid()
    for off in range(54, 126, 18):  # the base block's descriptors; 0xFC = product name
        d = e[off:off + 18]
        if len(d) == 18 and d[:2] == b"\0\0" and d[3] == 0xFC:
            name = d[5:].split(b"\n")[0].decode("ascii", "replace").strip()
            name = "".join(c for c in name if c.isalnum() or c in " -_.+")
            if name:
                return name
    return "Monitor"


def monitor_has_audio():
    e = monitor_edid()
    for b in range(1, len(e) // 128):
        block = e[b * 128:(b + 1) * 128]
        if block[0] == 0x02 and block[3] & 0x40:  # CEA-861 extension, "basic audio"
            return True
    return False


# ── docked mode ──────────────────────────────────────────────────────────

def docked():
    r = subprocess.run(["kreadconfig6"] + KEY, capture_output=True, text=True)
    return r.stdout.strip() == "true"


def set_docked(on):
    value = "true" if on else "false"
    if subprocess.run(["kwriteconfig6", "--notify"] + KEY + [value]).returncode != 0:
        log("kwriteconfig6 failed, docked mode not changed")
        return False
    env = dict(os.environ, QT_QPA_PLATFORM="offscreen")  # as startplasmamobile runs it
    env.pop("XDG_ACTIVATION_TOKEN", None)
    env.pop("DESKTOP_STARTUP_ID", None)
    r = subprocess.run(["plasma-mobile-envmanager", "--apply-settings"], env=env,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if r.returncode != 0:
        log("plasma-mobile-envmanager failed: KWin may keep the old window rules")
    return True


def dock():
    if os.path.exists(BEFORE):  # turned on by us already (maybe before a restart)
        if not docked():
            set_docked(True)
        return
    if docked():
        log("monitor connected: docked mode was on already, left alone")
        return
    try:
        write_file(BEFORE, "false")
    except OSError as e:
        log("monitor connected: docked mode left off (nowhere to keep what the phone had: %s)" % e)
        return
    if set_docked(True):
        log("monitor connected: docked mode on (the phone had it off)")


def undock():
    if not os.path.exists(BEFORE):
        return
    before = read_file(BEFORE) == "true"
    if set_docked(before):
        os.unlink(BEFORE)
        log("monitor gone: docked mode back %s, as the phone had it" % ("on" if before else "off"))


# ── sound ────────────────────────────────────────────────────────────────

def pactl(*args):
    try:
        r = subprocess.run(["pactl"] + list(args), capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return 1, ""
    return r.returncode, r.stdout


def display_module(modules_out):
    for line in modules_out.splitlines():
        f = line.split("\t")
        if len(f) >= 3 and f[1] == "module-alsa-sink" and ("sink_name=" + DISPLAY_SINK) in f[2].split():
            return f[0]
    return None


def sink_names():
    rc, out = pactl("list", "short", "sinks")
    return [line.split("\t")[1] for line in out.splitlines() if "\t" in line] if rc == 0 else []


def sound_on():
    """Sound to the monitor. False: try again later (PulseAudio not up, audio not announced yet)."""
    rc, out = pactl("list", "short", "modules")
    if rc != 0:
        return False
    if display_module(out) is not None:
        return True  # there already; if the user picked another output since, that stays
    # The default before the monitor: read it first, module-switch-on-connect moves it at once
    rc, before = pactl("get-default-sink")
    before = before.strip() if rc == 0 else ""
    name = monitor_name()
    props = "device.description='%s' device.icon_name='video-display'" % name
    rc, _ = pactl("load-module", "module-alsa-sink", *DISPLAY_SINK_ARGS, 'sink_properties="%s"' % props)
    if rc != 0:
        return False
    if before and before != DISPLAY_SINK and not os.path.exists(SINK_BEFORE):
        try:
            write_file(SINK_BEFORE, before)
        except OSError:
            pass
    pactl("set-default-sink", DISPLAY_SINK)
    rc, out = pactl("list", "short", "sink-inputs")
    for line in out.splitlines() if rc == 0 else []:
        pactl("move-sink-input", line.split("\t")[0], DISPLAY_SINK)
    log("monitor connected: sound to %s" % name)
    return True


def sound_off():
    rc, out = pactl("list", "short", "modules")
    if rc != 0:
        return
    module = display_module(out)
    if module is None:
        return
    pactl("unload-module", module)  # PulseAudio moves its streams to the next default
    before = read_file(SINK_BEFORE)
    if before and before in sink_names():
        pactl("set-default-sink", before)
    try:
        os.unlink(SINK_BEFORE)
    except OSError:
        pass
    log("monitor gone: sound back to %s" % (before or "the default output"))


# ── both ─────────────────────────────────────────────────────────────────

def sync():
    """Bring everything in line with the monitor. Returns False when sound should be retried."""
    if monitor_connected():
        dock()
        if not monitor_has_audio():
            return True
        return sound_on()
    undock()
    sound_off()
    return True


def main():
    if not os.environ.get("PLASMA_PLATFORM", "").startswith("phone"):
        return 0  # Plasma Mobile only (Phosh docks by itself)
    os.makedirs(STATE, exist_ok=True)
    try:
        if os.path.getsize(LOG) > 65536:
            os.unlink(LOG)
    except OSError:
        pass

    loop = GLib.MainLoop()
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)  # the process ends when the session's bus goes
    Gio.bus_own_name_on_connection(bus, NAME, Gio.BusNameOwnerFlags.ALLOW_REPLACEMENT | Gio.BusNameOwnerFlags.REPLACE,
                                   None, lambda *a: loop.quit())

    # Kernel uevents: an unprivileged process may listen (NETLINK_KOBJECT_UEVENT, group 1).
    uevents = socket.socket(socket.AF_NETLINK, socket.SOCK_DGRAM, 15)
    uevents.bind((0, 1))
    timer = {"id": 0, "retries": 0}

    def run():
        timer["id"] = 0
        if sync():
            timer["retries"] = 0
        elif timer["retries"] < 20:  # the sound comes some time after the picture, PulseAudio after login
            timer["retries"] += 1
            timer["id"] = GLib.timeout_add(3000, run)
        else:
            log("monitor connected, but its sound couldn't be set up (tried for a minute)")
            timer["retries"] = 0
        return False

    def later(ms):
        if timer["id"]:
            GLib.source_remove(timer["id"])
        timer["retries"] = 0
        timer["id"] = GLib.timeout_add(ms, run)

    def on_uevent(fd, cond):
        try:
            msg = uevents.recv(16384)
        except OSError:
            return True
        if b"\0SUBSYSTEM=drm\0" in msg:
            later(1500)  # a plug comes as several events and KWin needs a moment: check once it is quiet
        return True

    def heal():
        if not timer["id"]:
            run()
        return True

    GLib.io_add_watch(uevents.fileno(), GLib.PRIORITY_DEFAULT, GLib.IO_IN, on_uevent)
    GLib.timeout_add_seconds(60, heal)  # a missed event heals within a minute
    log("started (monitor %s)" % ("connected" if monitor_connected() else "not connected"))
    run()
    loop.run()
    log("stopped")
    return 0


if __name__ == "__main__":
    sys.exit(main())
