[Desktop Entry]
Type=Application
Name=Remote Desktop screen
Comment=Makes the browser's screen on the phone's desktop (Open Android DeX's postmarketOS helper)
Exec=/usr/local/libexec/s24-remote/openandroiddex-pmos
NoDisplay=true
X-KDE-Wayland-Interfaces=zkde_screencast_unstable_v1,org_kde_kwin_fake_input
