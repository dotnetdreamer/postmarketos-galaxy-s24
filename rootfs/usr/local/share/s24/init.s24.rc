# Galaxy S24 postmarketOS: the whole Android init config of the modem container (Claude, 2026-11-14).
# Android's own init (second stage) runs it in a private mount + PID namespace with the stock
# system/vendor images; only the services the modem and the camera need are defined, so nothing
# else of Android (zygote, surfaceflinger, ...) can start. Every service needs an explicit seclabel: without one
# init asks the kernel to compute the label, which fails with SELinux off ("Could not get process
# context"); setexeccon() of a fixed label works (no policy loaded -> kernel SID). Service lines are copied from the stock vendor rc files.

on early-init
    loglevel 7
    mkdir /dev/socket 0755 root root
    # APEXes (bionic, ICU, VNDK v34): init's own tmpfs over /apex hides the container's mounts
    # and apexd is not run, so bind the copies android-env.sh keeps under /data
    mkdir /apex/com.android.runtime 0755 root root
    mount none /data/s24apex/com.android.runtime /apex/com.android.runtime bind
    mkdir /apex/com.android.i18n 0755 root root
    mount none /data/s24apex/com.android.i18n /apex/com.android.i18n bind
    mkdir /apex/com.android.vndk.v34 0755 root root
    mount none /data/s24apex/com.android.vndk.v34 /apex/com.android.vndk.v34 bind
    # linker namespaces, generated by Android's own linkerconfig from the APEX list apexd would
    # write (vendor programs need their VNDK libc++ apart from system's LLNDK libraries)
    copy /data/s24ctr/apex-info-list.xml /apex/apex-info-list.xml
    chmod 0644 /apex/apex-info-list.xml
    exec u:r:linkerconfig:s0 root root -- /apex/com.android.runtime/bin/linkerconfig --target /linkerconfig

on init
    mkdir /mnt/vendor 0755 root root
    mkdir /mnt/vendor/efs 0771 radio system
    mkdir /mnt/vendor/cpefs 0771 radio system
    mkdir /data/vendor 0771 root root
    mkdir /data/vendor/log 0771 root system
    mkdir /data/vendor/log/cbd 0771 root system
    mkdir /data/vendor/radio 0771 radio radio
    mkdir /data/vendor/conn 0771 radio radio
    mkdir /data/vendor/secradio 0770 radio radio
    # the RIL reads /efs/... (IMEI area); the system image has an empty /efs for it
    mount none /mnt/vendor/efs /efs bind
    setprop vendor.cbd.partition radio
    setprop persist.vendor.cbd.btl_size 64

on late-init
    write /dev/kmsg "s24ctr: late-init reached"
    start logd
    start servicemanager
    start hwservicemanager
    start vndservicemanager
    # the RIL takes its wakelocks through the suspend HAL and blocks until it exists; it only
    # suspends the phone when told to (enableAutosuspend, by system_server), which never runs here
    chown system system /sys/power/state
    chown system system /sys/power/wakeup_count
    chmod 0660 /sys/power/state
    chown radio wakelock /sys/power/wake_lock
    chown radio wakelock /sys/power/wake_unlock
    chmod 0660 /sys/power/wake_lock
    chmod 0660 /sys/power/wake_unlock
    start system_suspend

# what runs is chosen after start (android-ctr0.sh start [radio] [camera]): setprop s24.radio 1 /
# s24.camera 1, so a camera session doesn't boot the modem and the other way round
on property:s24.radio=1
    # SIM slot setup the stock boot takes from /mnt/vendor/efs/factory.prop and telephony.prop
    # (written by secril_config_svc): this S24 is dual SIM, so rild must open both IPC channels
    setprop ro.multisim.simslotcount 2
    setprop ro.vendor.multisim.simslotcount 2
    setprop persist.radio.multisim.config dsds
    setprop persist.radio.def_network 26,26
    setprop ro.multisim.default_network 26
    write /sys/module/cpif/parameters/ds_detect 2
    start cpboot-daemon
    start ril-daemon

# camera: Samsung's camera provider (AIDL ICameraProvider/internal/0) and the gralloc allocator it
# allocates from (IAllocator/default); the camera kernel modules are loaded by android-ctr0.sh
on property:s24.camera=1
    setprop vendor.camera.unihal.enable true
    mkdir /data/vendor/camera 0770 root root
    mkdir /data/vendor/postprocess 0770 root root
    mkdir /data/vendor/postprocess/eraw 0770 root root
    mkdir /data/vendor/postprocess/native 0770 root root
    setprop vendor.camera.ppp.erawtid 0
    setprop vendor.camera.ppp.nativetid 0
    setprop vendor.camera.ppp.erawstart 0
    setprop vendor.camera.ppp.nativestart 0
    start vendor.graphics.allocator-default
    start sec-camera-provider
    start cameraserver

service logd /system/bin/logd
    seclabel u:r:logd:s0
    socket logd stream 0666 logd logd
    socket logdr seqpacket 0666 logd logd
    socket logdw dgram+passcred 0222 logd logd
    user logd
    group logd system package_info readproc
    capabilities SYSLOG AUDIT_CONTROL

service servicemanager /system/bin/servicemanager
    seclabel u:r:servicemanager:s0
    # SELinux stays off here; this shim only lets their selinux_status_open() check pass
    setenv LD_LIBRARY_PATH /data/s24ctr
    setenv LD_PRELOAD /data/s24ctr/libs24selinux.so
    user system
    group system readproc

service hwservicemanager /system/bin/hwservicemanager
    seclabel u:r:hwservicemanager:s0
    user system
    group system readproc

service vndservicemanager /vendor/bin/vndservicemanager /dev/vndbinder
    seclabel u:r:vndservicemanager:s0
    # SELinux stays off here; this shim only lets their selinux_status_open() check pass
    setenv LD_LIBRARY_PATH /data/s24ctr
    setenv LD_PRELOAD /data/s24ctr/libs24selinux.so
    user system
    group system readproc

service system_suspend /system/bin/hw/android.system.suspend-service
    seclabel u:r:system_suspend:s0
    user system
    group system wakelock
    capabilities BLOCK_SUSPEND

service cpboot-daemon /vendor/bin/cbd -d -t ss310 -P by-name/radio -bm -mm -B umts_boot0 -D umts_ramdump0 -n /mnt/vendor/efs -o s -o v -o m
    seclabel u:r:cbd:s0
    user root
    group radio cache inet misc audio sdcard_rw log sdcard_r shell system

service ril-daemon /vendor/bin/hw/rild
    seclabel u:r:rild:s0
    user radio
    group radio cache inet misc audio log oem_2901 system drmrpc vpn readproc wakelock net_admin
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW SYS_ADMIN CHOWN SYS_TIME

# stock: user system; root here: mdev gives /dev/dma_heap/* to root
service vendor.graphics.allocator-default /vendor/bin/hw/android.hardware.graphics.allocator-aidl-service-sgr
    seclabel u:r:hal_graphics_allocator_default:s0
    user root
    group graphics drmrpc
    capabilities SYS_NICE

# stock: user cameraserver; root here, since mdev gives the camera nodes (video*, v4l-subdev*,
# dma_heap/camera) to root, not to system:camera as Android's ueventd does
service sec-camera-provider /vendor/bin/hw/vendor.samsung.hardware.camera.provider-service_64
    seclabel u:r:hal_camera_default:s0
    user root
    group audio camera input drmrpc system media_rw sdcard_rw media vendor_secdir wakelock
    ioprio rt 4

# Android's own camera service: connects to sec-camera-provider and offers the standard
# ICameraService (media.camera), which handles gralloc buffer allocation internally through
# libgui/libui, so an NDK client (AImageReader) can capture without touching Samsung's gralloc.
# LD_LIBRARY_PATH names the APEX lib dirs by hand because linkerconfig's ld.config.txt is absent.
service cameraserver /system/bin/cameraserver
    seclabel u:r:cameraserver:s0
    setenv LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/apex/com.android.i18n/lib64:/apex/com.android.runtime/lib64:/apex/com.android.vndk.v34/lib64
    user root
    group audio camera input drmrpc system media_rw
    ioprio rt 4
