#!/sbin/openrc-run
# Galaxy S24 postmarketOS (Claude, 2026-11-15): the Samsung modem under ModemManager's D-Bus API
# (s24-mmd), so NetworkManager handles mobile data and the desktop shows signal and the data switch.
# The supervised program (s24-mmd-run) starts the Android modem container in the background.
# Log: /var/log/s24-mmd.log. Replaces the older s24-mobile-data service (don't run both).

description="Samsung modem for NetworkManager and the desktop (ModemManager API)"

supervisor=supervise-daemon
command=/usr/local/sbin/s24-mmd-run
output_log=/var/log/s24-mmd.log
error_log=/var/log/s24-mmd.log
respawn_delay=5
respawn_max=0

depend() {
	need dbus localmount
	before NetworkManager
	after s24-sensors s24-bluetooth
}

stop_post() {
	/usr/local/sbin/s24-mobile-data-hook down - >/dev/null 2>&1
	return 0
}
