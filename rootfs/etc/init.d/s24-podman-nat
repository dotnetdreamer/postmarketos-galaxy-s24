#!/sbin/openrc-run
# /etc/init.d/s24-podman-nat (Claude, 2026-11-15): containers on podman's own networks
# (10.88.0.0/14: the default 10.88/16 and the 10.89.x/24 ones podman makes) reach the internet
# through the phone. netavark can't (no nftables in this kernel); legacy iptables can.
description="Outbound NAT for podman's container networks"
NETS="10.88.0.0/14"

depend() {
	after net s24-podman-api
}

start() {
	ebegin "NAT for podman networks ${NETS}"
	sysctl -q -w net.ipv4.ip_forward=1
	iptables-legacy -t nat -C POSTROUTING -s "$NETS" ! -d "$NETS" -j MASQUERADE 2>/dev/null ||
		iptables-legacy -t nat -A POSTROUTING -s "$NETS" ! -d "$NETS" -j MASQUERADE
	eend $?
}

stop() {
	ebegin "No NAT for podman networks"
	iptables-legacy -t nat -D POSTROUTING -s "$NETS" ! -d "$NETS" -j MASQUERADE 2>/dev/null
	eend 0
}
